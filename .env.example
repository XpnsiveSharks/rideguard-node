# Runtime
NODE_ENV=local
PORT=5565
API_VERSION=1

# Comma-separated list of allowed origins.
# In production, you must name them explicitly and cannot use *.
CORS_ORIGINS=*

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-example@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-this-with-your-private-key\n-----END PRIVATE KEY-----\n"
# Firebase Web API key used by the backend for email/password Auth REST calls.
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
# For the Auth Emulator use http://127.0.0.1:9099/identitytoolkit.googleapis.com/v1.
FIREBASE_AUTH_API_BASE_URL=https://identitytoolkit.googleapis.com/v1

# Cloudinary server-side signed uploads
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Ably realtime messaging.
ABLY_API_KEY=your-app-id.your-key-id:your-key-secret
UPSTREAM_ABLY_API_KEY=upstream-app-id.upstream-key-id:upstream-key-secret
# Server-only key with publish capability on rideguard:buttons:device:*
DEVICE_ABLY_ISSUER_API_KEY=device-app-id.device-key-id:device-key-secret

# Shared secret the model-api sends as X-Service-Key to resolve a button's cameras.
# Must match DEVICE_RESOLVER_SERVICE_KEY in the model-api .env. Min 16 chars.
DEVICE_RESOLVER_SERVICE_KEY=your-shared-service-key

# Longest phone capture session the server accepts, in ms. Must be at least the
# app's PHONE_CAPTURE_SESSION_DURATION_MS.
PHONE_SESSION_MAX_DURATION_MS=600000

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Background alert auto-archive pass. Keep false until existing alerts are
# backfilled (scripts/backfill-alert-archive-fields.ts) and the Firestore
# composite indexes are built. See docs/auto-archive.md.
AUTO_ARCHIVE_ENABLED=false
SOS_ENABLED=false

# SMS API PH (SOS alert delivery). No caller exists yet; see
# docs/unimplemented-features/replaceable-sms-provider.md.
SMS_API_PH_BASE_URL=https://smsapiph.onrender.com
SMS_API_PH_API_KEY=your-smsapiph-api-key
SMS_API_PH_TIMEOUT_MS=10000

# TextBee (SOS alert delivery through a paired Android phone's SIM). Active
# SMS provider; see docs/unimplemented-features/replaceable-sms-provider.md.
# TEXTBEE_DEVICE_ID is optional - leave blank to use TextBee's default device.
TEXTBEE_BASE_URL=https://api.textbee.dev
TEXTBEE_API_KEY=your-textbee-api-key
TEXTBEE_DEVICE_ID=
TEXTBEE_TIMEOUT_MS=10000
