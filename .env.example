# Runtime
NODE_ENV=local
PORT=5565
API_VERSION=1

# Comma-separated list of allowed origins.
# In production, you must name them explicitly and cannot use *.
CORS_ORIGINS=*

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-example@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-this-with-your-private-key\n-----END PRIVATE KEY-----\n"

# Rate limiting: window length in milliseconds, and the max requests a
# single client (by IP) gets within that window before getting a 429.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
