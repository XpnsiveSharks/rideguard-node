        {
          "name": "Disconnect all hardware devices",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{firebaseToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/devices/disconnect?device=all",
              "host": ["{{baseUrl}}"],
              "path": ["devices", "disconnect"],
              "query": [
                {
                  "key": "device",
                  "value": "all",
                  "description": "Target device type: all (default), button, or camera"
                }
              ]
            },
            "description": "Disconnects all hardware peripherals (both button and camera) currently associated with the authenticated rider. Teardown ends any active phone camera session and clears stream URLs/presence."
