{
  "info": {
    "_postman_id": "rideguard-change-password-v1",
    "name": "RideGuard Change Password",
    "description": "Two-step change password flow:\n1. POST /auth/change-password/request (authenticated) — verifies currentPassword via Identity Toolkit, sends 6-digit code via Nodemailer.\n2. POST /auth/change-password/confirm (authenticated) — verifies currentPassword, validates single-use code, updates password via Admin SDK, and revokes refresh tokens.\n\nPasswords, tokens, and verification codes are never logged or returned by the API; keep them in Postman variables only.\n\nAfter a successful change, Firebase refresh tokens for the user are revoked — re-login with the new password to continue.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5565/v1" },
    { "key": "firebaseIdToken", "value": "PASTE_YOUR_FIREBASE_ID_TOKEN_HERE" },
    { "key": "email", "value": "replace-with-test-gmail@gmail.com" },
    { "key": "currentPassword", "value": "Password1" },
    { "key": "newPassword", "value": "Password2" },
    { "key": "wrongPassword", "value": "WrongPass1" },
    { "key": "verificationCode", "value": "PASTE_CODE_FROM_INBOX" },
    { "key": "wrongCode", "value": "000000" }
  ],
  "item": [
    {
      "name": "1 Request change password (success)",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{firebaseIdToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{currentPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/change-password/request",
        "description": "200. Verifies currentPassword via Identity Toolkit. On success, generates a 6-digit code, stores it hashed with purpose 'change_password', and emails it via SMTP. Response never returns the code."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('success envelope', () => {",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.message).to.eql('Verification code sent');",
              "  pm.expect(body.data.success).to.eql(true);",
              "  pm.expect(JSON.stringify(body)).to.not.include(pm.collectionVariables.get('currentPassword'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2 Request with wrong current password",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{firebaseIdToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{wrongPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/change-password/request",
        "description": "401 Invalid password. Verifies current password server-side before sending an email."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "const body = pm.response.json();",
              "pm.test('error envelope', () => {",
              "  pm.expect(body.success).to.eql(false);",
              "  pm.expect(body.message).to.eql('Invalid password.');",
              "  pm.expect(body.statusCode).to.eql(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3 Confirm change password (success)",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{firebaseIdToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{currentPassword}}\",\n  \"code\": \"{{verificationCode}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/change-password/confirm",
        "description": "200. Re-verifies current password, verifies 6-digit code, updates password via Admin SDK, revokes all refresh tokens, and deletes the code document."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('success envelope', () => {",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.message).to.eql('Password changed successfully');",
              "  pm.expect(body.data.success).to.eql(true);",
              "  pm.expect(JSON.stringify(body)).to.not.include(pm.collectionVariables.get('currentPassword'));",
              "  pm.expect(JSON.stringify(body)).to.not.include(pm.collectionVariables.get('newPassword'));",
              "  pm.expect(JSON.stringify(body)).to.not.include(pm.collectionVariables.get('verificationCode'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4 Confirm wrong code",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{firebaseIdToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{currentPassword}}\",\n  \"code\": \"{{wrongCode}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/change-password/confirm",
        "description": "400 Invalid verification code. Increments attempt counter on the code doc."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));",
              "const body = pm.response.json();",
              "pm.test('error envelope', () => {",
              "  pm.expect(body.success).to.eql(false);",
              "  pm.expect(body.message).to.eql('Invalid verification code.');",
              "  pm.expect(body.statusCode).to.eql(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5 Confirm expired code",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{firebaseIdToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{currentPassword}}\",\n  \"code\": \"{{verificationCode}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/change-password/confirm",
        "description": "400 Verification code has expired. Triggered when confirming after TTL (default 10m)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));",
              "const body = pm.response.json();",
              "pm.test('error envelope', () => {",
              "  pm.expect(body.success).to.eql(false);",
              "  pm.expect(body.message).to.eql('Verification code has expired.');",
              "  pm.expect(body.statusCode).to.eql(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6 Confirm new equals current",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{firebaseIdToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{currentPassword}}\",\n  \"code\": \"{{verificationCode}}\",\n  \"newPassword\": \"{{currentPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/change-password/confirm",
        "description": "400 New password must be different from the current password."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));",
              "const body = pm.response.json();",
              "pm.test('error envelope', () => {",
              "  pm.expect(body.success).to.eql(false);",
              "  pm.expect(body.message).to.eql('New password must be different from the current password.');",
              "  pm.expect(body.statusCode).to.eql(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7 Unauthenticated request",
      "request": {
        "method": "POST",
        "auth": { "type": "noauth" },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{currentPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/change-password/request",
        "description": "401 Missing bearer token on Step 1."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "const body = pm.response.json();",
              "pm.test('error envelope', () => {",
              "  pm.expect(body.success).to.eql(false);",
              "  pm.expect(body.message).to.eql('Missing bearer token');",
              "  pm.expect(body.statusCode).to.eql(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8 Unauthenticated confirm",
      "request": {
        "method": "POST",
        "auth": { "type": "noauth" },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{currentPassword}}\",\n  \"code\": \"{{verificationCode}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/change-password/confirm",
        "description": "401 Missing bearer token on Step 2."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "const body = pm.response.json();",
              "pm.test('error envelope', () => {",
              "  pm.expect(body.success).to.eql(false);",
              "  pm.expect(body.message).to.eql('Missing bearer token');",
              "  pm.expect(body.statusCode).to.eql(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9 Login with new password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{email}}\",\n  \"password\": \"{{newPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/login",
        "description": "Run after a successful change. 200 data.uid/email proves the new password works. Login does not return tokens."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('login data', () => {",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data.uid).to.be.a('string');",
              "  pm.expect(body.data.email).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
