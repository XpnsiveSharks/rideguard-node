{
  "info": {
    "_postman_id": "rideguard-change-password-v1",
    "name": "RideGuard Change Password",
    "description": "Authenticated POST /auth/change-password. Requires a verified user and firebaseIdToken. Passwords and tokens are never returned by the API; keep them in Postman secret/collection variables only.\n\nAfter a successful change, Firebase refresh tokens for the user are revoked — re-login with the new password to continue.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5565/v1" },
    { "key": "firebaseIdToken", "value": "PASTE_YOUR_FIREBASE_ID_TOKEN_HERE" },
    { "key": "email", "value": "replace-with-test-gmail@gmail.com" },
    { "key": "currentPassword", "value": "Password1" },
    { "key": "newPassword", "value": "Password2" },
    { "key": "wrongPassword", "value": "WrongPass1" }
  ],
  "item": [
    {
      "name": "1 Change password (success)",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{firebaseIdToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{currentPassword}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/change-password",
        "description": "200. Verifies currentPassword via Identity Toolkit, updates via Admin SDK, revokes refresh tokens. Response never includes passwords or tokens."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('success envelope', () => {",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.message).to.eql('Password changed successfully');",
              "  pm.expect(body.data.success).to.eql(true);",
              "  pm.expect(JSON.stringify(body)).to.not.include(pm.collectionVariables.get('currentPassword'));",
              "  pm.expect(JSON.stringify(body)).to.not.include(pm.collectionVariables.get('newPassword'));",
              "});"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "Password changed",
          "originalRequest": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Password1\",\n  \"newPassword\": \"Password2\"\n}"
            },
            "url": "{{baseUrl}}/auth/change-password"
          },
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"success\": true,\n  \"message\": \"Password changed successfully\",\n  \"data\": {\n    \"success\": true\n  },\n  \"timestamp\": \"2026-10-30T00:00:00.000Z\"\n}"
        }
      ]
    },
    {
      "name": "2 Wrong current password",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{firebaseIdToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{wrongPassword}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/change-password",
        "description": "401 Invalid password. Matches delete-account wrong-password convention."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "const body = pm.response.json();",
              "pm.test('error envelope', () => {",
              "  pm.expect(body.success).to.eql(false);",
              "  pm.expect(body.message).to.eql('Invalid password.');",
              "  pm.expect(body.statusCode).to.eql(401);",
              "});"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "Invalid password",
          "originalRequest": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"WrongPass1\",\n  \"newPassword\": \"Password2\"\n}"
            },
            "url": "{{baseUrl}}/auth/change-password"
          },
          "status": "Unauthorized",
          "code": 401,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"success\": false,\n  \"message\": \"Invalid password.\",\n  \"statusCode\": 401,\n  \"timestamp\": \"2026-10-30T00:00:00.000Z\"\n}"
        }
      ]
    },
    {
      "name": "3 Weak new password",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{firebaseIdToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{currentPassword}}\",\n  \"newPassword\": \"short\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/change-password",
        "description": "400 validation — newPassword reuses registration rules (min 8, letter, number)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));",
              "const body = pm.response.json();",
              "pm.test('validation envelope', () => {",
              "  pm.expect(body.success).to.eql(false);",
              "  pm.expect(body.statusCode).to.eql(400);",
              "  pm.expect(body.fields).to.be.an('object');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4 New equals current",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{firebaseIdToken}}", "type": "string" }]
        },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{currentPassword}}\",\n  \"newPassword\": \"{{currentPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/change-password",
        "description": "400 New password must be different from the current password."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));",
              "const body = pm.response.json();",
              "pm.test('error envelope', () => {",
              "  pm.expect(body.success).to.eql(false);",
              "  pm.expect(body.message).to.eql('New password must be different from the current password.');",
              "  pm.expect(body.statusCode).to.eql(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5 Unauthenticated",
      "request": {
        "method": "POST",
        "auth": { "type": "noauth" },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{currentPassword}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/change-password",
        "description": "401 Missing bearer token (global FirebaseAuthGuard)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "const body = pm.response.json();",
              "pm.test('error envelope', () => {",
              "  pm.expect(body.success).to.eql(false);",
              "  pm.expect(body.message).to.eql('Missing bearer token');",
              "  pm.expect(body.statusCode).to.eql(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6 Login with new password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{email}}\",\n  \"password\": \"{{newPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/login",
        "description": "Run after a successful change. 200 data.uid/email proves the new password works. Login does not return tokens."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('login data', () => {",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data.uid).to.be.a('string');",
              "  pm.expect(body.data.email).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
